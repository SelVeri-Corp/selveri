{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "client/out",
    "rootDir": "client/src",
    "strict": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "types": ["node", "vscode"]
  },
  "include": ["client/src"],
  "exclude": ["node_modules", ".vscode-test"]
}
