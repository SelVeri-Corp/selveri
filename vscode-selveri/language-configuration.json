{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "\\b(then|do)\\s*$|::\\s*$",
    "decreaseIndentPattern": "^\\s*\\b(fi|od|end)\\b"
  },
  "wordPattern": "[A-Za-z_\\u0370-\\u03FF\\u1F00-\\u1FFF][A-Za-z0-9_\\u0370-\\u03FF\\u1F00-\\u1FFF]*"
}
