// Dependency scheduler / topological processing order.
// Tasks are integers. Each edge edgeFrom[e] -> edgeTo[e] means "from before to".

function validateTopologicalOrder(order: List[Int, 1], edgeFrom: List[Int, 1], edgeTo: List[Int, 1]) -> Int ::
    ok : Int;
    ok := 1;

    i : Int;
    i := 0;
    while i < len(order) do
        e : Int;
        e := 0;
        while e < len(edgeFrom) do
            if edgeTo[e] = order[i] then
                seenPrereq : Int;
                seenPrereq := 0;

                k : Int;
                k := 0;
                while k < i do
                    if order[k] = edgeFrom[e] then
                        seenPrereq := 1;
                    fi
                    k := k + 1;
                od

                if seenPrereq = 0 then
                    ok := 0;
                fi
            fi
            e := e + 1;
        od
        i := i + 1;
    od

    { (ok = 1) => (
        Forall pos in [0...len(order) - 1] .
            Forall edge in [0...len(edgeFrom) - 1] .
                (edgeTo[&edge] = order[&pos]) =>
                    (Exists earlier in [0...len(order) - 1] .
                        (&earlier < &pos) && (order[&earlier] = edgeFrom[&edge]))
    ) };

    return ok;
end

order : List[Int, 1, 4];
order := [0, 1, 2, 3];
edgeFrom : List[Int, 1, 3];
edgeFrom := [0, 1, 2];
edgeTo : List[Int, 1, 3];
edgeTo := [2, 2, 3];

call validateTopologicalOrder(order, edgeFrom, edgeTo);
valid : Int;
valid := retvar;

{ valid = 1 };
writeline(valid);

