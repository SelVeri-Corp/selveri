// Interactive fulfillment: order parameters come from stdin.
// SelVeri verifies the chosen center against business rules even when
// requestQty, maxHours, and maxRisk are not known at compile time.
//
// Input from stdin:
//   3
//   5
//   10
//
// Or from the shell:
//   echo -e "3\n5\n10" | selveri examples/interactive_fulfillment_order.svi

function chooseFastestCenter(stock: List[Int, 1], shipHours: List[Int, 1], risk: List[Int, 1], requestQty: Int, maxHours: Int, maxRisk: Int) -> Int ::
    center : Int;
    center := obtain(&c, {
        Exists c in [0...len(stock) - 1] .
            (stock[&c] >= requestQty) &&
            (shipHours[&c] <= maxHours) &&
            (risk[&c] <= maxRisk) &&
            (Forall other in [0...len(stock) - 1] .
                ((stock[&other] >= requestQty) &&
                 (shipHours[&other] <= maxHours) &&
                 (risk[&other] <= maxRisk)) =>
                    (shipHours[&c] <= shipHours[&other]))
    });

    { (0 <= center) && (center < len(stock)) };
    { stock[center] >= requestQty };
    { shipHours[center] <= maxHours };
    { risk[center] <= maxRisk };

    return center;
end

stock : List[Int, 1, 4];
stock := [0, 4, 10, 3];

shipHours : List[Int, 1, 4];
shipHours := [12, 5, 2, 1];

risk : List[Int, 1, 4];
risk := [20, 7, 50, 4];

requestQty : Int;
requestQty := read();

maxHours : Int;
maxHours := read();

maxRisk : Int;
maxRisk := read();

{ requestQty > 0 };
{ maxHours > 0 };
{ maxRisk >= 0 };

call chooseFastestCenter(stock, shipHours, risk, requestQty, maxHours, maxRisk);
center : Int;
center := retvar;

stock[center] := stock[center] - requestQty;

{ stock[center] >= 0 };
{ Forall i in [0...len(stock) - 1] . stock[&i] >= 0 };

writeline(center);
writeline(stock);
