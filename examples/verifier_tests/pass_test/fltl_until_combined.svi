// =====================================================
// fLTL Until + Combined: all specs should PASS (True)
// Boolean combinations, nesting, lists, quantifiers
// =====================================================

x : Int;
x := 0;

y : Int;
y := 0;

phase : Int;
phase := 0;

lst : List[Int, 1, 3];
lst := [0, 0, 0];

stable : List[Int, 1, 3];
stable := [2, 4, 6];

// =====================================================
// Combined future operators
// =====================================================

{ (Eventually x = 2) && (Eventually x + y = 5) };         // True
x := 1;
y := 1;
x := 2;
y := 3;

{ (Always (Exists e in stable . &e = 4)) || (Eventually y = 99) }; // True
stable[0] := 8;
stable[2] := 10;

{ !(Eventually y = 42) };                                  // True
y := 5;

// =====================================================
// Temporal + FOL mix
// =====================================================

{ (Eventually phase = 2) => (Eventually (Forall i in [0...2] . lst[&i] > 0)) }; // True
phase := 1;
lst := [1, 2, 3];
phase := 2;

{ ((phase < 4) && (y < 10)) Until (phase = 4) };          // True
phase := 3;
phase := 4;

// Nested future operator
{ Eventually (Always phase >= 4) };                       // True
phase := 5;
