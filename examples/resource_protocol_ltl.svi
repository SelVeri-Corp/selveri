// Resource protocol: open, use, close.
// Action encoding: 1 = open, 2 = use, 3 = close.

function replayResource(actions: List[Int, 1]) -> Int ::
    isOpen : Int;
    isOpen := 0;
    closed : Int;
    closed := 0;
    currentAction : Int;
    currentAction := 0;
    used : Int;
    used := 0;
    i : Int;
    i := 0;

    { resourceRules :=
        (Always ((currentAction = 2) => (isOpen = 1))) &&
        (Always ((isOpen = 1) => (Eventually closed = 1)))
    };

    while i < len(actions) do
        currentAction := actions[i];

        if currentAction = 1 then
            isOpen := 1;
            closed := 0;
        fi

        if (currentAction = 2) and (isOpen = 1) then
            used := used + 1;
        fi

        if currentAction = 3 then
            isOpen := 0;
            closed := 1;
        fi

        { (currentAction = 2) => (isOpen = 1) };
        i := i + 1;
    od

    { end resourceRules };
    { isOpen = 0 };

    return used;
end

actions : List[Int, 1, 4];
actions := [1, 2, 2, 3];

call replayResource(actions);
used : Int;
used := retvar;

{ used = 2 };
writeline(used);

