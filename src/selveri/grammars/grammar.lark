// ================== LEXER ==================
// Ignore whitespace
%import common.WS
%ignore WS

// Comment support
%ignore /\/\/[^\n]*/
%ignore /\/\*[\s\S]*?\*\//

SPEC_SLOT: /@[A-Za-z0-9_]+/
IDENT: /[A-Za-z][A-Za-z0-9_]*/
REAL_LIT: /[0-9]+\.[0-9]+/
INT_LIT: /[0-9]+/

COMP_OP: "=" | "<=" | "<" | ">=" | ">"

// ================== PARSER ==================
start: program
program: func_decl* stmt_seq

// A sequence is zero or more contracts.
// Semicolon policy is enforced by the contract forms below.
stmt_seq: stmt*

?stmt: terminated_stmt
     | unterminated_stmt
     | empty_stmt

empty_stmt: ";"

// ------------------ STATEMENTS ------------------

// Statements that MUST end with ';'
?terminated_stmt: semicolon_stmt ";"
?semicolon_stmt: decl
               | assign
               | list_assign
               | pass_stmt
               | func_call
               | write_stmt
               | writeline_stmt
               | spec_annot

pass_stmt: "pass"

write_stmt: "write" "(" aexp ")"
writeline_stmt: "writeline" "(" aexp ")"

spec_annot: SPEC_SLOT

// Statements that MUST NOT end with ';'
?unterminated_stmt: if_stmt
                  | while_stmt

// Explicit fi removes dangling-else ambiguity
if_stmt: "if" bexp "then" stmt_seq "else" stmt_seq "fi"        -> if_else_stmt
       | "if" bexp "then" stmt_seq "fi"

while_stmt: "while" bexp "do" stmt_seq "od"

decl: IDENT ":" type                                                      -> decl_stmt
assign: IDENT ":=" aexp                                                   -> assign_stmt
list_assign: indexed_value ":=" aexp                                      -> list_assign_stmt

?indexed_value: IDENT "[" aexp "]"                                        -> a_index_base
              | indexed_value "[" aexp "]"                                -> a_index_chain

// ------------------ TYPES ------------------
?basic_type: "Int"                                                              -> type_int
           | "Real"                                                            -> type_real
?type: basic_type
     | "List" "[" basic_type "," INT_LIT "," aexp_list "]"                  -> type_list

aexp_list: aexp ("," aexp)*

// ------------------ IMMEDIATES ------------------
?imm: INT_LIT                                                             -> int_lit
    | REAL_LIT                                                           -> real_lit
    | list_lit

list_lit: "[" [imm ("," imm)*] "]"

// ------------------ ARITHMETIC EXPRESSIONS ------------------
aexp: aexp_sum

?aexp_sum: aexp_sum "+" aexp_term                                         -> add
         | aexp_sum "-" aexp_term                                         -> sub
         | aexp_term

?aexp_term: aexp_term "*" aexp_factor                                    -> mul
          | aexp_term "/" aexp_factor                                      -> div
          | aexp_factor

?aexp_factor: "-" aexp_factor                                            -> neg
            | aexp_atom

?aexp_atom: imm
         | IDENT                                                          -> a_var
         | "len" "(" IDENT ")"                                            -> a_len
         | indexed_value                                                  
         | "(" aexp ")"
         | "read" "(" ")"                                                 -> a_read
         | "obtain" "(" "&" IDENT "," SPEC_SLOT ")"                       -> a_obtain

// ------------------ BOOLEAN EXPRESSIONS ------------------
bexp: b_or

?b_or: b_or "or" b_xor                                                    -> bor
     | b_xor

?b_xor: b_xor "xor" b_and                                                 -> bxor
      | b_and

?b_and: b_and "and" b_not                                                 -> band
      | b_not

?b_not: "not" b_not                                                       -> bnot
      | b_atom

?b_atom: "true"                                                           -> btrue
      | "false"                                                           -> bfalse
      | comparison
      | aexp                                                              -> truthy
      | "(" bexp ")"
      | SPEC_SLOT                                                         -> bspec

comparison: aexp COMP_OP aexp                                             -> compare

// ------------------ FUNCTIONS ------------------
func_decl: "function" IDENT "(" param_list? ")" "->" return_type "::" func_stmt_seq "end"

?return_type: type
            | dynamic_list_type

?param_list: param ("," param)*
?param: IDENT ":" param_type_node                                          -> param_type

?param_type_node: type
                | dynamic_list_type

dynamic_list_type: "List" "[" basic_type "," INT_LIT "]"

func_stmt_seq: func_stmt*
?func_stmt:  func_terminated_stmt
           | func_unterminated_stmt
           | empty_stmt

?func_terminated_stmt: func_semicolon_stmt ";"
?func_semicolon_stmt: decl
                    | assign
                    | list_assign
                    | func_call
                    | pass_stmt
                    | return_stmt
                    | spec_annot

?func_unterminated_stmt: func_if_stmt
                        | func_while_stmt

func_if_stmt: "if" bexp "then" func_stmt_seq "else" func_stmt_seq "fi"        -> func_if_else_stmt
             | "if" bexp "then" func_stmt_seq "fi"

func_while_stmt: "while" bexp "do" func_stmt_seq "od"

return_stmt: "return" aexp

// Calls
func_call: "call" IDENT "(" arg_list_opt ")"
?arg_list_opt: arg_list?
?arg_list: aexp ("," aexp)*
