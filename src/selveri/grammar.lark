// ================== LEXER ==================
// Ignore whitespace
%import common.WS
%ignore WS

// Comment support
%ignore /\/\/[^\n]*/
%ignore /\/\*[\s\S]*?\*\//

IDENT: /[A-Za-z_][A-Za-z0-9_]*/
FLOAT_LIT: /[0-9]+\.[0-9]+/
INT_LIT: /[0-9]+/

COMP_OP: "=" | "<=" | "<" | ">=" | ">"

// ================== PARSER ==================
start: program
program: func_decl* stmt_seq

// A sequence is zero or more contracts.
// Semicolon policy is enforced by the contract forms below.
stmt_seq: stmt*

?stmt: terminated_stmt
     | unterminated_stmt
     | spec_annot                                        -> spec_annot
     | ";"                                               -> empty_stmt

?spec_annot: "{" spec "}" ";"

// ------------------ STATEMENTS ------------------

// Statements that MUST end with ';'
?terminated_stmt: semicolon_stmt ";"
?semicolon_stmt: decl
               | assign
               | list_assign
               | "pass"                                               -> pass_stmt
               | func_call

// Statements that MUST NOT end with ';'
?unterminated_stmt: if_stmt
                  | while_stmt

// Explicit fi removes dangling-else ambiguity
if_stmt: "if" bexp "then" stmt_seq "else" stmt_seq "fi"        -> if_else_stmt
       | "if" bexp "then" stmt_seq "fi"                            -> if_stmt

while_stmt: "while" bexp "do" stmt_seq "od"                        -> while_stmt

decl: IDENT ":" type                                                      -> decl_stmt
assign: IDENT ":=" aexp                                                   -> assign_stmt
list_assign: indexed_value ":=" aexp                                      -> list_assign_stmt

?indexed_value: IDENT "[" aexp "]"                                        -> a_index
              | indexed_value "[" aexp "]"                                -> a_index

// ------------------ TYPES ------------------
?basic_type: "Int"                                                              -> type_int
           | "Float"                                                            -> type_float
?type: basic_type
     | "List" "[" basic_type "," INT_LIT "," aexp_list "]"                  -> type_list

aexp_list: aexp ("," aexp)*                                               -> aexp_list

// ------------------ IMMEDIATES ------------------
?imm: INT_LIT                                                             -> int_lit
    | FLOAT_LIT                                                           -> float_lit
    | list_lit

list_lit: "[" [imm ("," imm)*] "]"                                        -> list_lit

// ------------------ ARITHMETIC EXPRESSIONS ------------------
aexp: aexp_sum                                                              -> aexp

?aexp_sum: aexp_sum "+" aexp_term                                         -> add
         | aexp_sum "-" aexp_term                                         -> sub
         | aexp_term

?aexp_term: aexp_term "*" aexp_factor                                    -> mul
          | aexp_term "/" aexp_factor                                      -> div
          | aexp_factor

?aexp_factor: "-" aexp_factor                                            -> neg
            | aexp_atom

?aexp_atom: imm
         | IDENT                                                          -> a_var
         | "len" "(" IDENT ")"                                            -> a_len
         | indexed_value                                                  
         | "(" aexp ")"

// ------------------ BOOLEAN EXPRESSIONS ------------------
bexp: b_or                                                                -> bexp

?b_or: b_or "or" b_xor                                                    -> bor
     | b_xor

?b_xor: b_xor "xor" b_and                                                 -> bxor
      | b_and

?b_and: b_and "and" b_not                                                 -> band
      | b_not

?b_not: "not" b_not                                                       -> bnot
      | b_atom

?b_atom: "true"                                                           -> btrue
      | "false"                                                           -> bfalse
      | comparison
      | aexp                                                              -> truthy
      | "(" bexp ")"

comparison: aexp COMP_OP aexp                                             -> compare

// ------------------ SPECIFICATIONS ------------------
?spec: spec_imp                                                          

?spec_imp: spec_or "=>" spec_imp                                          -> simp
         | spec_or

?spec_or: spec_or "||" spec_and                                           -> sor
        | spec_and

?spec_and: spec_and "&&" spec_temp                                        -> sand
         | spec_temp

?spec_temp: spec_temp "Since" spec_unary                                  -> ssince
          | spec_temp "Until" spec_unary                                  -> suntil
          | spec_unary

?spec_unary: "!" spec_unary                                               -> snot
           | "Previously" spec_unary                                      -> spreviously
           | "Once" spec_unary                                            -> sonce
           | "Historically" spec_unary                                    -> shistorically
           | "Next" spec_unary                                            -> snext
           | "Eventually" spec_unary                                      -> seventually
           | "Always" spec_unary                                          -> salways
           | "Forall" IDENT domain_opt "." spec                           -> sforall
           | "Exists" IDENT domain_opt "." spec                           -> sexists
           | bexp                                                         -> sbexp
           | "(" spec ")"

_domain_in: "in" domain
domain_opt: _domain_in?                                                   -> domain_opt

?domain: interval
       | IDENT                                                            -> domain_ident
       | set_lit
       | type                                                             -> domain_type

interval: "[" aexp "," aexp ")"                                           -> interval_halfopen
        | "[" aexp "," aexp "]"                                           -> interval_closed

set_lit: "{" aexp_list "}"                                                -> set_lit

// ------------------ FUNCTIONS ------------------
func_decl: "function" IDENT "(" param_list? ")" "->" return_type "::" func_stmt_seq "end" -> func_decl

?return_type: type
            | dynamic_list_type

?param_list: param ("," param)*
?param: IDENT ":" param_type_node                                          -> param_type

?param_type_node: type
                | dynamic_list_type

dynamic_list_type: "List" "[" basic_type "," INT_LIT "]"                  -> dynamic_list_type

func_stmt_seq: func_stmt*
?func_stmt:  func_terminated_stmt
           | func_unterminated_stmt
           | spec_annot                                                 -> spec_annot
           | ";"                                                          -> empty_stmt

?func_terminated_stmt: func_semicolon_stmt ";"
?func_semicolon_stmt: decl
                    | assign
                    | list_assign
                    | func_call
                    | "pass"                                                 -> pass_stmt
                    | return_stmt

?func_unterminated_stmt: func_if_stmt
                        | func_while_stmt

func_if_stmt: "if" bexp "then" func_stmt_seq "else" func_stmt_seq "fi"        -> func_if_else_stmt
             | "if" bexp "then" func_stmt_seq "fi"                              -> func_if_stmt

func_while_stmt: "while" bexp "do" func_stmt_seq "od"                          -> func_while_stmt

return_stmt: "return" aexp                                                    -> return_stmt

// Calls
func_call: "call" IDENT "(" arg_list_opt ")"                                  -> func_call
?arg_list_opt: arg_list?
?arg_list: aexp ("," aexp)* -> arg_list
